# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789,987654321

# Secret token for webhook validation (required in production)
WEBHOOK_SECRET=your_secret_token_here

# Public URL for the webhook endpoint (required in production)
WEBHOOK_URL=https://your-cloud-run-url.a.run.app

# URL path for the webhook endpoint
WEBHOOK_PATH=/webhook

# Use webhook mode (true) or polling mode (false)
USE_WEBHOOK=false

# Logging level: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO

# Server port (set automatically by Cloud Run in production)
PORT=8080

# Support email shown to users in limit-reached messages
SUPPORT_EMAIL=hello@zpoint.app

# Telegram user ID to receive admin notifications (e.g. global limit reached)
ADMIN_USER_ID=
